{
  "name": "youchang",
  "private": true,
  "version": "2.9.3",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-sites-build.mjs",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "android:sync": "pnpm build && node node_modules/@capacitor/cli/bin/capacitor sync android && pnpm android:assets",
    "android:apk": "pnpm android:sync && powershell -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "e2e": "playwright test",
    "assets:check": "node scripts/verify-mascot-assets.mjs && node scripts/verify-audio-asset.mjs",
    "check": "pnpm assets:check && playwright install chromium && pnpm typecheck && pnpm test:run && pnpm build && pnpm e2e"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/local-notifications": "8.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "sharp": "0.35.3",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "latest"
  }
}
